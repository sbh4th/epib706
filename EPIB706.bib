@article{mansournia2018,
  title = {Case–Control Matching: Effects, Misconceptions, and Recommendations},
  shorttitle = {Case–Control Matching},
  author = {Mansournia, Mohammad Ali and Jewell, Nicholas Patrick and Greenland, Sander},
  date = {2018-01-01},
  journaltitle = {European Journal of Epidemiology},
  shortjournal = {Eur J Epidemiol},
  volume = {33},
