@article{eisenberg-guyot2025,
  title = {Inconsistent Consistency: Evaluating the Well-Defined Intervention Assumption in Applied Epidemiological Research},
  shorttitle = {Inconsistent Consistency},
  author = {Eisenberg-Guyot, Jerzy and Kezios, Katrina L and Prins, Seth J and Schwartz, Sharon},
  date = {2025-04-01},
  journaltitle = {International Journal of Epidemiology},
