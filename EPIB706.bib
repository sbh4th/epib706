@article{luijken2022,
  title = {Exploratory Analyses in Aetiologic Research and Considerations for Assessment of Credibility: Mini-Review of Literature},
  shorttitle = {Exploratory Analyses in Aetiologic Research and Considerations for Assessment of Credibility},
  author = {Luijken, Kim and Dekkers, Olaf M. and Rosendaal, Frits R. and Groenwold, Rolf H. H.},
  date = {2022-05-03},
  journaltitle = {BMJ},
