  keywords = {health economic evaluation,race,racial health disparities,risk assessment algorithms},
  file = {/Users/samharper/Dropbox/work/research/zotero/Briggs-2022-Healing_the.pdf}
}

@article{broadbent2021,
  title = {The {{C-word}}, the {{P-word}}, and Realism in Epidemiology},
  author = {Broadbent, Alex},
