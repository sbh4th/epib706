  urldate = {2022-12-15},
  abstract = {Think: What are the main achievements of epidemiology that come immediately to your mind?Water contaminated by sewage and cholera? Tobacco and lung cancer? It is unlikely that the NIH Multiple Risk Factor Intervention Trial, or MRFIT (pronounced “Mister Fit”), was on your short list. However, the intention behind MRFIT to accrue interventional evidence to support preventive action should be seen as an extremely important episode of the history of epidemiology. The surprising results of the trial have occulted its innovative dimensions. Blackburn (1), Kuller (2), and Odoms-Young and Thorpe (3), in this issue of the Journal, allow us to reassess the strengths and weaknesses of MRFIT, along with the story of another cardiovascular trial, the proposed National Cooperative Trial on Multifactorial Prevention of First Heart Attacks and Coronary Mortality in Free-Living, High-Risk, Middle-Aged American Men, nicknamed JUMBO, supposedly after Barnum \&amp; Bailey Circus’s 12-foot, 7-ton elephant, because it was big. Unfunded, JUMBO never took off. MRFIT and JUMBO were conceived in the 1970s when the National Institutes of Health (NIH) had decided that the time had come to allocate more money than ever before to a large-scale trial that would evaluate the effectiveness of a multifactor intervention to prevent coronary heart disease (CHD).},
  file = {/Users/samharper/Dropbox/work/research/zotero/Morabia-AJE-2020-Editorial.pdf;/Users/samharper/Zotero/storage/DUGSD5RX/5706792.html}
